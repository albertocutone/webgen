# Copy to .env.local for local development. Both values are PUBLIC client-side
# keys: they are compiled into the JS bundle and visible to anyone. They are
# not secrets. Never put anything genuinely secret in a VITE_* variable.
#
# In CI these are provided as GitHub Actions secrets purely to keep them out of
# the repository, not because they are confidential.

# https://web3forms.com — access key that routes submissions to the owner's inbox
VITE_WEB3FORMS_KEY=

# https://dash.cloudflare.com — Turnstile *site* key (not the secret key)
VITE_TURNSTILE_SITE_KEY=
