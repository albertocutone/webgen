# Dependencies
node_modules/

# Build output
dist/
dist-ssg/
.vite/

# Test artifacts
coverage/
playwright-report/
test-results/
blob-report/
.playwright/

# Environment (never commit real keys)
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Tooling / OS
.eslintcache
.DS_Store

# Playwright / visual review
screenshots/
dist-ssr/

# Raw source material the site was built from (photos, saved pages).
# Never committed: the saved Facebook pages contain the owner's personal
# account email, and the repository is public. Selected, processed assets
# live in assets/photos and assets/brand instead.
assets/source/
# Source photography IS committed: CI regenerates the WebP variants from it,
# and the generated manifest that tests import must match what is in the repo.
# Only the generated variants are ignored.
public/images/**/*.webp
# Generated from assets/brand/logo.jpg by scripts/build-logo.mjs
public/favicon.png
public/apple-touch-icon.png
public/og-image.jpg
